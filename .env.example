# 复制本文件为 .env，填上你自己的值。.env 已经在 .gitignore 里，不会被提交。
# 一键启动脚本（start.bat）会引导你填，也可以自己改这里。

# 必填：DeepSeek API Key（https://platform.deepseek.com/api_keys）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# 主人 QQ：管理命令只认这个号
# RICEFISH_OWNER_QQ=10001

# 可选：主人的显示名，会写进提示词的【关系】块（默认显示「主人」）
# RICEFISH_OWNER_NAME=你的名字

# 白名单：首次运行的种子。加好白名单后建议在管理面板「白名单」页维护，
# 面板保存过之后以面板（数据库）为准，这里的值不再覆盖它。
# RICEFISH_ALLOWED_GROUPS=123456789,987654321
# RICEFISH_ALLOWED_FRIENDS=10001

# 可选：换模型（默认 deepseek-flash）
# RICEFISH_MODEL=deepseek-flash

# 可选：NapCat 反向 WS 的 token，必须和 NapCat 里填的一致
# RICEFISH_WS_TOKEN=

# 可选：管理面板 Token 和端口
# RICEFISH_PANEL_TOKEN=
# RICEFISH_PANEL_PORT=8721
# 可选：面板监听地址（Docker 里用 0.0.0.0；本机保持 127.0.0.1）
# RICEFISH_WEB_HOST=127.0.0.1

# 可选：日志输出为 JSON（云上采集用）
# RICEFISH_LOG_JSON=0

# 可选：换 API 网关（默认就是官方地址）
# DEEPSEEK_BASE_URL=https://api.deepseek.com
